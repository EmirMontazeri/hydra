<?xml version="1.0" encoding="utf-8"?>
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file-set product-name="Hydra Download Manager" product-version="${version}">
      <include path="hydra.exe" min-matches="0" max-matches="1" />
      <include path="hydra-gui.exe" min-matches="0" max-matches="1" />
      <include path="hydra-host.exe" min-matches="0" max-matches="1" />
      <include path="hydra-updater.exe" min-matches="0" max-matches="1" />
      <include path="hydra-plugin.exe" min-matches="0" max-matches="1" />
      <include path="uninstall.exe" min-matches="0" max-matches="1" />
      <include path="hydra-*-setup.exe" min-matches="0" max-matches="1" />
      <include path="ffi-*-hydra.dll" min-matches="0" max-matches="unbounded" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
    <powershell-file-set>
      <include path="**/*.ps1" min-matches="0" max-matches="unbounded" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </powershell-file-set>
  </zip-file>
</artifact-configuration>
